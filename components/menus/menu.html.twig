
{# Set the class for this component, including any classes set by variants. #}
{% set classes = [
    'menu'
  ]|merge(classes ?? [])
%}

<nav class="{{ classes|join(" ") }}">
  <h2>{{ menu_title }}</h2>
  <ul>
    {% for item in menu_items %}
      <li><a href="{{ base_url }}{{ item.href }}">{{ item.title }}</a></li>
    {% endfor %}
  </ul>
</nav>
