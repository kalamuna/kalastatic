
{% extends "@components/section.html.twig" %}

{# Allow a block of text to be placed in the content. #}
{% block content %}
  {% block text %}
  {% endblock text %}
  {% for component in component_files %}
    <p>Name: {{ component.name }}</p>
    <p>Path: {{ component.path }}</p>
  {% endfor %}
{% endblock content %}
