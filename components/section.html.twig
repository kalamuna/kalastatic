{# For some reason the classes array is not coming in as a proper array and is messing up the merge below. #}
{% set classes = [classes|join(" ")] %}

{# Set the class for this component, including any classes set by variants. #}
{% set classes = [
    'section'
  ]|merge(classes ? classes : [])
%}

<section class="{{ classes|join(" ") }}">
  <h2>{{ heading }}</h2>
  {% block content %}
  {% endblock content %}
</section>
