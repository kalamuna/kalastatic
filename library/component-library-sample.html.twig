
<section id="{{ component }}" class="component-library-sample">

  <h2>{{ name }} </h2>

  {% if description %}
    <p>{{ description }}</p>
  {% endif %}

    <details open>
      <summary>Sample</summary>
      <div class="details-content">
        {% block example %}
        {% endblock example %}
      </div>
    </details>

    <details>
      <summary>Twig</summary>
      <div class="details-content">
        <pre>{{ source("@components/" ~ file_root ~ ".html.twig")|escape('html') }}</pre>
      </div>
    </details>

    {% if file_root ~ ".scss" in component_files %}
      <details>
        <summary>SCSS</summary>
        <div class="details-content">
          <pre>{{ source("@components/" ~ file_root ~ ".scss") }}</pre>
        </div>
      </details>
    {% endif %}

    {% if file_root ~ ".js" in component_files %}
      <details>
        <summary>JS</summary>
        <div class="details-content">
          <pre>{{ source("@components/" ~ file_root ~ ".js") }}</pre>
        </div>
      </details>
    {% endif %}

</section>
