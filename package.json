{
  "name": "kstat_test",
  "version": "1.0.0",
  "description": "A test case for the new version of Kalastatic.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node main.js",
    "watch": "nodemon -e twig,scss,css,js --watch components --watch library --watch pages --watch templates serve.js"
  },
  "kalastatic": {
    "build_directory": "build",
    "pages_directory": "pages",
    "assets_directory": "assets",
    "namespaces": {
      "templates": "templates",
      "components": "components",
      "library": "library"
    }
  },
  "dependencies": {
    "drupal-twig-extensions": "^1.0.0-beta.4",
    "nodemon": "^2.0.21",
    "sass": "^1.58.3",
    "serve": "^14.2.0",
    "twig": "^1.16.0"
  }
}
