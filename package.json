{
  "name": "kstat_test",
  "version": "1.0.0",
  "description": "A test case for the new version of Kalastatic.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node main.js",
    "watch": "nodemon -e twig,scss,css,js --watch components --watch styles --watch styleguide --watch pages --watch templates --exec npm run build",
    "test": "npm run build",
    "start": "npm run watch & npm run serve",
    "serve": "serve build"
  },
  "kalastatic": {
    "sources": {
      "pages": "build"
    },
    "assets": {
      "assets": "build/assets"
    },
    "namespaces": {
      "styles": "styles",
      "components": "components",
      "templates": "templates",
      "pages": "pages",
      "styleguide": "styleguide"
    },
    "styles": {
      "styles/styles.scss": "build/styles.css"
    }
  },
  "dependencies": {
    "drupal-twig-extensions": "^1.0.0-beta.4",
    "sass": "^1.58.3",
    "twig": "^1.16.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.21",
    "serve": "^14.2.0"
  }
}
