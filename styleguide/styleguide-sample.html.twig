
{% extends "@components/sections/section.html.twig" %}

{# Set the class for this component. #}
{% set classes = [
    'styleguide-sample',
    add_padding ? 'styleguide-sample--add-padding' : ''
  ]
%}

{# Set the class for this component. #}
{% set heading = name %}

{% block content %}

  {% if description %}
    <p>{{ description }}</p>
  {% endif %}

    <details open>
      <summary>Sample</summary>
      <div class="details-content">
        {% block sample %}
        {% endblock sample %}
      </div>
    </details>

    <details>
      <summary>Sample Twig</summary>
      <div class="details-content">
        {% set sample_source = source(file_root ~ ".sample.twig") %}
        {# Display the contents of the sample.twig file, and remove everything outside of the sample block. #}
        <pre>{{ sample_source|split("{% block sample %}")[1]|split("{% endblock sample %}")[0]|escape('html') }}</pre>
      </div>
    </details>

    {% if file_root ~ ".html.twig" in namespaceFiles[namespace] %}
      <details>
        <summary>Twig Template</summary>
        <div class="details-content">
          <pre>{{ source(file_root ~ ".html.twig")|escape('html') }}</pre>
        </div>
      </details>
    {% endif %}

    {% if file_root ~ ".scss" in namespaceFiles[namespace] %}
      <details>
        <summary>SCSS</summary>
        <div class="details-content">
          <pre>{{ source( file_root ~ ".scss") }}</pre>
        </div>
      </details>
    {% endif %}

    {% if file_root ~ ".js" in namespaceFiles[namespace] %}
      <details>
        <summary>JS</summary>
        <div class="details-content">
          <pre>{{ source( file_root ~ ".js") }}</pre>
        </div>
      </details>
    {% endif %}

{% endblock content %}
