
{# Search through the files in a namespace to create a section for each sample.twig file. #}
{% macro findSamples(namespace) %}

  {# Iterate through all of the component files and output the samples on in the styleguide. #}
  {% set sampleRoots = [] %}
  {% for file in namespaceFiles[namespace] %}
    {% if '.sample.twig' in file %}
      {% embed file with {'namespace': namespace, 'file_root': file|replace({'.sample.twig': ''}) } %}{% endembed %}
    {% endif %}
  {% endfor %}

{% endmacro %}

{# Create the styleguide and component library by finding sample files in each of the namespaces. #}
<div class="styleguide">
  {% import _self as myPage %}
  {% for namespace in namespaceFiles|keys %}
    {{ myPage.findSamples(namespace) }}
  {% endfor %}
</div>
