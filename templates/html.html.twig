<html>
  <head>
    <title>{{ title }}</title>
    {{ stylesheets }}
  </head>
  <body>
    {% block body %}
    {% endblock body %}

    {# Output the stylesheets again afer the body block until we figure out hoisting issue.#}
    {% for stylesheet in stylesheets %}
      <link href="{{ base_url }}/{{ stylesheet }}" rel="stylesheet">
    {% endfor %}

    {{ stylesheets }}
    {{ scripts }}
  </body>
</html>
